# Copy to docker/platform.env, then:
# docker compose --env-file docker/platform.env up --build -d

POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=open_agents
POSTGRES_DB=open_agents

# On Linux, set DOCKER_GID to `stat -c %g /var/run/docker.sock`.
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=0

APP_URL=http://openagents.localhost
BETTER_AUTH_URL=http://openagents.localhost
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
LOCAL_AUTH_EMAIL=owner@example.com
LOCAL_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional. Fine-grained tokens are preferred.
LOCAL_GITHUB_ACCESS_TOKEN=

# 32 random bytes as hex. Encrypts model-provider API keys in Postgres.
ENCRYPTION_KEY=

WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10
WORKFLOW_POSTGRES_MAX_POOL_SIZE=12

# Optional. Direct providers can also be configured in Settings.
AI_GATEWAY_API_KEY=

# Optional voice transcription.
ELEVENLABS_API_KEY=
