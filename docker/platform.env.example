# Platform host + routing
OPEN_AGENTS_APP_HOST=openagents.kesku.me
OPEN_AGENTS_HTTP_PORT=80
OPEN_AGENTS_ENV_FILE=/etc/open-agents/platform.env

# Persistent service credentials
POSTGRES_DB=open_agents
POSTGRES_USER=open_agents
POSTGRES_PASSWORD=

# App secrets
JWE_SECRET=
ENCRYPTION_KEY=

# Model providers
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai/v1

# Optional GitHub operator token
LOCAL_GITHUB_ACCESS_TOKEN=

# Sandbox runtime
SANDBOX_BACKEND=docker-container
NEXT_PUBLIC_SANDBOX_BACKEND=docker-container
DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_IMAGE=open-agents-sandbox:local
SANDBOX_NETWORK=open-agents
SANDBOX_DOMAIN_SUFFIX=kesku.me
SANDBOX_PUBLIC_PROTOCOL=https
SANDBOX_WORKSPACE_ROOT=/var/lib/open-agents/workspaces
SANDBOX_CONTAINER_CPU=1
SANDBOX_CONTAINER_MEMORY_MB=1024
SANDBOX_CONTAINER_PIDS_LIMIT=512
SANDBOX_PLATFORM_RESERVED_CPU=1
SANDBOX_PLATFORM_RESERVED_MEMORY_MB=1536
SANDBOX_MAX_CONTAINERS=8
SANDBOX_ORPHAN_WORKSPACE_TTL_MS=21600000
SANDBOX_RECONCILE_INTERVAL_MS=60000
