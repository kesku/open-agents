# Minimum runtime
POSTGRES_URL=
JWE_SECRET=

# Required to sign in and store provider tokens
# Must be a 32-byte hex string (64 characters)
ENCRYPTION_KEY=

# Required for the default direct model provider
OPENAI_API_KEY=

# Optional OpenAI-compatible provider for Perplexity-routed models
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=

# Optional GitHub access for local single-user mode
# The local repo picker uses this token directly and accepts pasted GitHub repo URLs.
LOCAL_GITHUB_ACCESS_TOKEN=

# Sandbox backend selection
SANDBOX_BACKEND=
NEXT_PUBLIC_SANDBOX_BACKEND=

# Local Proxmox LXC pool over SSH
# PROXMOX_LXC_POOL must be valid JSON with exactly 4 entries, for example:
# [{"id":"oa-1","host":"192.168.1.130"},{"id":"oa-2","host":"192.168.1.131"},{"id":"oa-3","host":"192.168.1.132"},{"id":"oa-4","host":"192.168.1.133"}]
PROXMOX_LXC_POOL=
PROXMOX_SSH_USER=
PROXMOX_SSH_PRIVATE_KEY_PATH=
PROXMOX_SSH_KNOWN_HOSTS_PATH=
PROXMOX_SSH_STRICT_HOST_KEY_CHECKING=
PROXMOX_LXC_WORKSPACE_PATH=
PROXMOX_LXC_RESET_COMMAND=
PROXMOX_LXC_PREVIEW_URL_TEMPLATE=
PROXMOX_LXC_PROVISIONING_STALE_MS=
