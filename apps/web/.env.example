# Defaults to local when omitted.
OPEN_AGENTS_DEPLOYMENT_MODE=local
NEXT_PUBLIC_OPEN_AGENTS_DEPLOYMENT_MODE=local

POSTGRES_URL=postgresql://open_agents:open_agents@localhost:5432/open_agents
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Local owner account. Sign-up is disabled; create with:
# pnpm --dir apps/web auth:bootstrap
LOCAL_AUTH_EMAIL=owner@example.com
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_NAME=Open Agents Owner
LOCAL_AUTH_USERNAME=owner

# Server-only GitHub token for repo access. Never use a NEXT_PUBLIC_ prefix.
LOCAL_GITHUB_ACCESS_TOKEN=

# Workflow Postgres backend (requires a long-running web process).
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgresql://open_agents:open_agents@localhost:5432/open_agents
WORKFLOW_POSTGRES_JOB_PREFIX=open_agents
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10
WORKFLOW_POSTGRES_MAX_POOL_SIZE=12

SANDBOX_PROVIDER=docker
NEXT_PUBLIC_SANDBOX_PROVIDER=docker
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=open-agents-sandbox:local
SANDBOX_NETWORK=open-agents
SANDBOX_DOMAIN_SUFFIX=127.0.0.1.sslip.io
SANDBOX_PUBLIC_PROTOCOL=http
SANDBOX_CONTAINER_CPU=1
SANDBOX_CONTAINER_MEMORY_MB=2048
SANDBOX_CONTAINER_PIDS_LIMIT=512
SANDBOX_MAX_RUNNING=8

# 32 random bytes as hex. Encrypts model-provider API keys in Postgres.
ENCRYPTION_KEY=

# Optional. Direct OpenAI-compatible providers can be added in Settings without this.
AI_GATEWAY_API_KEY=

# Optional voice transcription.
ELEVENLABS_API_KEY=

# Vercel mode only. Set both deployment-mode variables to `vercel` first.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
OPEN_AGENTS_RESOURCE_PROFILE=
