# Minimum runtime
POSTGRES_URL=
JWE_SECRET=

# Required to sign in and store provider tokens
# Must be a 32-byte hex string (64 characters)
ENCRYPTION_KEY=

# Required for the default direct model provider
OPENAI_API_KEY=

# Local single-user mode (skips OAuth and always signs in the configured user)
LOCAL_AUTH_ENABLED=
LOCAL_AUTH_USER_ID=
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_NAME=
LOCAL_AUTH_AVATAR_URL=

# Sandbox backend selection
SANDBOX_BACKEND=
NEXT_PUBLIC_SANDBOX_BACKEND=

# Local Proxmox LXC pool over SSH
# PROXMOX_LXC_POOL must be valid JSON with exactly 4 entries, for example:
# [{"id":"oa-1","host":"192.168.1.130"},{"id":"oa-2","host":"192.168.1.131"},{"id":"oa-3","host":"192.168.1.132"},{"id":"oa-4","host":"192.168.1.133"}]
PROXMOX_LXC_POOL=
PROXMOX_SSH_USER=
PROXMOX_SSH_PRIVATE_KEY_PATH=
PROXMOX_SSH_KNOWN_HOSTS_PATH=
PROXMOX_SSH_STRICT_HOST_KEY_CHECKING=
PROXMOX_LXC_WORKSPACE_PATH=
PROXMOX_LXC_RESET_COMMAND=
PROXMOX_LXC_PREVIEW_URL_TEMPLATE=
PROXMOX_LXC_PROVISIONING_STALE_MS=

# Vercel OAuth (required for sign-in)
# Callback URL: {YOUR_ORIGIN}/api/auth/vercel/callback
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (required for repo access, pushes, and PRs)
# Callback URL: {YOUR_ORIGIN}/api/github/app/callback
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback
# In the GitHub App settings:
#   1. Enable "Request user authorization (OAuth) during installation"
#   2. Use the GitHub App Client ID and Client Secret below
#   3. Make the app public if you want org installs to work cleanly
#   4. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=

# Optional Redis / Vercel KV (resumable streams, stop signaling, caching)
REDIS_URL=
KV_URL=

# Optional deployment refinements
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
